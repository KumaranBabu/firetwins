# --- Code only: no solver binaries, no results, no documents ---------------------------------------
# FDS / Smokeview installation (hundreds of MB of binaries)
fds_smv/

# Documentation, reports and manuals (add back a folder with "!docs/active_docs/" if you want it on GitHub)
docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Tool and scratch folders
.claude/
tmp_async_test/

# Example cases: the older command-line run of the first demo is superseded by gui_run/
examples/*/run/
examples/*/results/
examples/**/*.pyfcache
examples/**/*.pyfstats
# generated copies of the manuals (the PDFs are kept; manual_body.html and manual_template.html are the sources)
examples/*/USER_MANUAL.html
examples/*/fine_mesh_manual.html
examples/*/user_manual_postprocessing.html

# FDS / Smokeview output anywhere
*.smv
*.s3d
*.s3d.sz
*.sf
*.bnd
*.q
*.pyfcache
*.pyfstats
*.out
*.csv
*.log

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# ...but the test fixtures are small and the tests need them
!tests/fixtures/
!tests/fixtures/**

# ...and the two demo-room cases are kept whole, with their FDS results, screenshots, films and PDF manuals (client trials)
!examples/demo_room_fire/gui_run/
!examples/demo_room_fire/gui_run/**
!examples/fine_mesh_demo_room/gui_run/
!examples/fine_mesh_demo_room/gui_run/**
