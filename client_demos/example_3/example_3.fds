&HEAD CHID='example_3', TITLE='Example 3: example 1 with the door closed, gas devices at head height' /

&TIME T_END=60.0, T_BEGIN=0.0 /
&DUMP DT_SLCF=1.0, DT_BNDF=1.0, DT_ISOF=1.0, DT_DEVC=1.0, DT_PL3D=10.0, SMOKE3D=.TRUE., DT_CTRL=1.0 /
&MISC TMPA=20.0, HUMIDITY=40.0, GVEC=0.0,0.0,-9.81, TURBULENCE_MODEL='DEARDORFF' /
&RADI NUMBER_RADIATION_ANGLES=104, RADIATION_ITERATIONS=1 /

&MATL ID='GYP_BOARD', DENSITY=930.00, CONDUCTIVITY=0.17, SPECIFIC_HEAT=1.09, EMISSIVITY=0.9 /
&REAC ID='PROPANE_FIRE', FUEL='PROPANE', HEAT_OF_COMBUSTION=46000.00, SOOT_YIELD=0.024, CO_YIELD=0.005, RADIATIVE_FRACTION=0.35, EPUMO2=13100.00 /
&SURF ID='GYPSUM_WALL_25MM', COLOR='IVORY', BACKING='VOID', GEOMETRY='CARTESIAN', MATL_ID='GYP_BOARD','GYP_BOARD', THICKNESS=0.0125,0.0125 /
&SURF ID='BURNER_SURF', COLOR='ORANGE', HRRPUA=500.00, TAU_Q=-15.0, BACKING='VOID', GEOMETRY='CARTESIAN' /
&MESH ID='DOMAIN', XB=0.0,6.0,0.0,4.5,0.0,3.0, IJK=60,45,30 /
&OBST ID='ROOM_S', XB=0.6,5.4,0.6,0.75,0.0,2.4, SURF_ID='GYPSUM_WALL_25MM', COLOR='GRAY' /
&OBST ID='ROOM_N', XB=0.6,5.4,3.75,3.9,0.0,2.4, SURF_ID='GYPSUM_WALL_25MM', COLOR='GRAY' /
&OBST ID='ROOM_W', XB=0.6,0.75,0.75,3.75,0.0,2.4, SURF_ID='GYPSUM_WALL_25MM', COLOR='GRAY' /
&OBST ID='ROOM_E', XB=5.25,5.4,0.75,3.75,0.0,2.4, SURF_ID='GYPSUM_WALL_25MM', COLOR='GRAY' /
&OBST ID='ROOM_ceiling', XB=0.6,5.4,0.6,3.9,2.4,2.55, SURF_ID='GYPSUM_WALL_25MM', COLOR='GRAY' /
&OBST ID='BURNER', XB=2.7,3.3,2.1,2.7,0.0,0.15, SURF_ID='INERT', COLOR='GRAY' /
&HOLE ID='ROOM_OPENING_2', XB=5.25,5.4,1.65,2.85,0.9,1.95 /
&VENT ID='BURNER_TOP', XB=2.7,3.3,2.1,2.7,0.15,0.15, SURF_ID='BURNER_SURF' /
&VENT ID='DOMAIN_XMIN_OPEN', XB=0.0,0.0,0.0,4.5,0.0,3.0, SURF_ID='OPEN' /
&VENT ID='DOMAIN_XMAX_OPEN', XB=6.0,6.0,0.0,4.5,0.0,3.0, SURF_ID='OPEN' /
&VENT ID='DOMAIN_YMIN_OPEN', XB=0.0,6.0,0.0,0.0,0.0,3.0, SURF_ID='OPEN' /
&VENT ID='DOMAIN_YMAX_OPEN', XB=0.0,6.0,4.5,4.5,0.0,3.0, SURF_ID='OPEN' /
&VENT ID='DOMAIN_ZMAX_OPEN', XB=0.0,6.0,0.0,4.5,3.0,3.0, SURF_ID='OPEN' /
&PROP ID='HEAT_DETECTOR_74C', QUANTITY='LINK TEMPERATURE', RTI=5.0, C_FACTOR=0.7, OFFSET=0.1, ACTIVATION_TEMPERATURE=74.0 /
&DEVC ID='HEAT_DET', QUANTITY='LINK TEMPERATURE', XYZ=3.0,2.4,2.35, PROP_ID='HEAT_DETECTOR_74C', INITIAL_STATE=.FALSE., TRIP_DIRECTION=1 /
&DEVC ID='TC_060', QUANTITY='TEMPERATURE', XYZ=3.0,2.4,0.6, INITIAL_STATE=.FALSE., TRIP_DIRECTION=1 /
&DEVC ID='TC_120', QUANTITY='TEMPERATURE', XYZ=3.0,2.4,1.2, INITIAL_STATE=.FALSE., TRIP_DIRECTION=1 /
&DEVC ID='TC_180', QUANTITY='TEMPERATURE', XYZ=3.0,2.4,1.8, INITIAL_STATE=.FALSE., TRIP_DIRECTION=1 /
&DEVC ID='TC_230', QUANTITY='TEMPERATURE', XYZ=3.0,2.4,2.3, INITIAL_STATE=.FALSE., TRIP_DIRECTION=1 /
&DEVC ID='CO_15', QUANTITY='VOLUME FRACTION', XYZ=1.5,3.0,1.5, INITIAL_STATE=.FALSE., TRIP_DIRECTION=1, SPEC_ID='CARBON MONOXIDE' /
&DEVC ID='CO2_15', QUANTITY='VOLUME FRACTION', XYZ=1.5,3.0,1.5, INITIAL_STATE=.FALSE., TRIP_DIRECTION=1, SPEC_ID='CARBON DIOXIDE' /
