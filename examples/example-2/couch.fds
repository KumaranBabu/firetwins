&HEAD CHID='couch', TITLE='Burning couch (FDS example Fires/couch), first 25 s' /

&TIME T_END=25.0, T_BEGIN=0.0 /
&DUMP DT_SLCF=1.0, DT_BNDF=1.0, DT_ISOF=1.0, DT_DEVC=5.0, DT_PL3D=10.0, SMOKE3D=.TRUE., NFRAMES=3000, DT_HRR=5.0, DT_CTRL=1.0 /
&MISC TMPA=20.0, HUMIDITY=40.0, GVEC=0.0,0.0,-9.81, TURBULENCE_MODEL='DEARDORFF' /
&PRES VELOCITY_TOLERANCE=0.05, MAX_PRESSURE_ITERATIONS=10 /
&RADI NUMBER_RADIATION_ANGLES=100, RADIATION_ITERATIONS=1 /

&MATL ID='FABRIC', DENSITY=50.0, CONDUCTIVITY=0.5, SPECIFIC_HEAT=1.0, EMISSIVITY=0.9, REFERENCE_TEMPERATURE=250.00, HEAT_OF_REACTION=500.00, HEAT_OF_COMBUSTION=16000.00, NU_SPEC=1.0, SPEC_ID='POLYURETHANE', N_REACTIONS=1, FYI='Properties completely fabricated' /
&MATL ID='FOAM', DENSITY=40.0, CONDUCTIVITY=0.1, SPECIFIC_HEAT=1.0, EMISSIVITY=0.9, REFERENCE_TEMPERATURE=280.00, HEAT_OF_REACTION=800.00, HEAT_OF_COMBUSTION=22700.00, NU_SPEC=1.0, SPEC_ID='POLYURETHANE', N_REACTIONS=1, FYI='Properties completely fabricated' /
&MATL ID='GYPSUM PLASTER', DENSITY=500.00, CONDUCTIVITY=0.5, SPECIFIC_HEAT=1.0, EMISSIVITY=0.9 /
&REAC ID='REAC_0', FUEL='POLYURETHANE', HEAT_OF_COMBUSTION=22700.00, SOOT_YIELD=0.01, CO_YIELD=0.0, RADIATIVE_FRACTION=0.35, EPUMO2=13100.00 /
&SPEC ID='POLYURETHANE', FORMULA='C6.3H7.1N1.0O2.1' /
&SURF ID='UPHOLSTERY', COLOR='PURPLE', BACKING='VOID', BURN_AWAY=.TRUE., GEOMETRY='CARTESIAN', FYI='Properties completely fabricated', MATL_ID(1:2,1)='FABRIC','FOAM', THICKNESS(1:2)=0.0005,0.1 /
&SURF ID='WALL', COLOR='GRAY', BACKING='VOID', GEOMETRY='CARTESIAN', RGB=200,200,200, MATL_ID='GYPSUM PLASTER', THICKNESS=0.012, DEFAULT=.TRUE. /
&SURF ID='ignitor', COLOR='GRAY', EMISSIVITY=1.0, BACKING='VOID', TMP_FRONT=1000.00, GEOMETRY='CYLINDRICAL', LENGTH=0.15, RADIUS=0.01 /
&MESH ID='MESH_0', XB=0.0,2.5,0.0,2.5,0.0,2.4, IJK=25,25,24, MULT_ID='mesh' /
&OBST ID='OBST_0', XB=1.5,3.1,3.8,4.6,0.0,0.4, SURF_ID='WALL', COLOR='GRAY', RGB=200,200,200 /
&OBST ID='OBST_1', XB=1.5,3.1,3.8,4.6,0.4,0.6, SURF_ID='UPHOLSTERY', COLOR='PURPLE', BULK_DENSITY=40.0 /
&OBST ID='OBST_2', XB=1.3,1.5,3.8,4.6,0.0,0.9, SURF_ID='UPHOLSTERY', COLOR='PURPLE', BULK_DENSITY=40.0 /
&OBST ID='OBST_3', XB=3.1,3.3,3.8,4.6,0.0,0.9, SURF_ID='UPHOLSTERY', COLOR='PURPLE', BULK_DENSITY=40.0 /
&OBST ID='OBST_4', XB=1.5,3.1,4.4,4.6,0.6,1.2, SURF_ID='UPHOLSTERY', COLOR='PURPLE', BULK_DENSITY=40.0 /
&MULT ID='mesh', DX=2.5, DY=2.5, DZ=0.0, I_LOWER=0, I_UPPER=1, J_LOWER=0, J_UPPER=1, K_LOWER=0, K_UPPER=0 /
&VENT ID='VENT_0', XB=1.0,4.0,0.0,0.0,0.0,2.0, SURF_ID='OPEN' /
&INIT ID='INIT_0', XB=2.4,2.7,4.1,4.4,0.6,0.7, PART_ID='ignitor particle', N_PARTICLES_PER_CELL=1, CELL_CENTERED=T /
&PART ID='ignitor particle', COLOR='BLUE', DRAG_LAW='SPHERE', SAMPLING_FACTOR=1, SURF_ID='ignitor', N_STRATA=6, STATIC=.TRUE. /
&SLCF ID='SLCF_0', QUANTITY='TEMPERATURE', PBX=2.5, VECTOR=.TRUE., CELL_CENTERED=.TRUE. /
&SLCF ID='SLCF_1', QUANTITY='HRRPUV', PBX=2.5, CELL_CENTERED=.TRUE. /
&BNDF QUANTITY='RADIATIVE HEAT FLUX' /
&BNDF QUANTITY='CONVECTIVE HEAT FLUX' /
&BNDF QUANTITY='NET HEAT FLUX' /
&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='BURNING RATE' /


&TAIL /